<?xml version="1.0" encoding="utf-8"?>
<!-- AxBurstEngine Resource Mappings for OnePlus Nord 4 (avalon) -->
<resources>
    <!-- CPU Frequency Target Nodes -->
    <resource id="0x0001" name="cpu_little_min" path="/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq" default="1900000" />
    <resource id="0x0002" name="cpu_little_max" path="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq" default="1900000" />
    
    <resource id="0x0003" name="cpu_big_min" path="/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq" default="2600000" />
    <resource id="0x0004" name="cpu_big_max" path="/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq" default="2600000" />
    
    <resource id="0x0005" name="cpu_prime_min" path="/sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq" default="2800000" />
    <resource id="0x0006" name="cpu_prime_max" path="/sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq" default="2800000" />

    <!-- GPU Frequency Nodes -->
    <resource id="0x000a" name="gpu_min_freq" path="/sys/class/kgsl/kgsl-3d0/min_clock_mhz" default="305" />
    <resource id="0x000b" name="gpu_max_freq" path="/sys/class/kgsl/kgsl-3d0/max_clock_mhz" default="950" />

    <!-- CPU Utilization Clamp Targets (uclamp) -->
    <resource id="0x0010" name="uclamp_top_min" path="/dev/cpuctl/top-app/cpu.uclamp.min" default="0" />
    <resource id="0x0011" name="uclamp_top_max" path="/dev/cpuctl/top-app/cpu.uclamp.max" default="1024" />
</resources>
